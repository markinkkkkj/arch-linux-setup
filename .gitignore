# ===========================================================================
# Secrets & credentials -- this repo holds dotfiles and may become public.
# Everything here is a typical dotfiles-repo leak vector.
# ===========================================================================

# --- SSH private keys and host data ---
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
id_dsa
id_dsa.*
*.pem
*.ppk
**/.ssh/known_hosts
**/.ssh/known_hosts.old
**/.ssh/authorized_keys

# --- GPG private material ---
**/.gnupg/private-keys-v1.d/
**/.gnupg/secring.gpg
**/.gnupg/trustdb.gpg
**/.gnupg/*.kbx
**/.gnupg/*.kbx~
*.asc.gpg
secring.*

# --- CLI tool credentials (gh, aws, gcloud, npm, docker) ---
**/gh/hosts.yml
**/.aws/credentials
**/.aws/config
**/gcloud/credentials.db
**/gcloud/access_tokens.db
**/gcloud/legacy_credentials/
**/gcloud/application_default_credentials.json
.npmrc
**/.npmrc
**/.docker/config.json

# --- Environment files ---
.env
.env.*
*.env
!*.env.example

# --- Shell history ---
.bash_history
.zsh_history
.histfile
*_history
.python_history
.node_repl_history
.lesshst

# --- Browser profile databases (cookies, logins, sessions) ---
*.sqlite
*.sqlite-wal
*.sqlite-shm
key4.db
key3.db
logins.json
signons.sqlite
cookies.*
**/Login Data
**/Session Storage/
**/Local Storage/

# --- Editor state & sync credentials (VS Code and friends) ---
**/Code/User/globalStorage/
**/Code/User/sync/
**/Code/User/workspaceStorage/
.vscode/argv.json

# --- Caches, logs, and other noise ---
.cache/
**/__pycache__/
*.log
arch-setup-*.log

# --- Artifacts generated by install.sh (reviewed and pasted by hand) ---
sway-keyboard-snippet.conf
sway-exec-snippet.conf

# --- Backups created by the scripts ---
dotfiles-backup-*/
*.bak-*
