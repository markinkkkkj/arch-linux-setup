# Sway config -- translated from the old hyprland.conf (Hyprland+kitty+rofi
# era), adapted to the current stack: Sway + foot + wofi.
# Monochrome theme: black / gray / white only, no accent colors.

### Variables ################################################################

set $mod Mod4
set $terminal foot
set $webbrowser zen-browser
set $filemanager thunar
set $menu wofi --show drun
set $scripts ~/.config/sway/scripts

### Output ###################################################################

# eDP-1 at native resolution, 1.2x scale (same as the old monitor= line).
output eDP-1 mode 1920x1080@60Hz scale 1.2 position 0 0

# Solid dark-gray background -- no wallpaper.
output * bg #1a1a1a solid_color

### Input ####################################################################

# ABNT2 with the ThinkPad XKB variant: the console kbd keymaps have no fix
# for this ThinkPad's "/" and "?" scancode quirk; the "thinkpad" variant
# does (see CLAUDE.md). TTY stays "us" on purpose.
input type:keyboard {
    xkb_layout br
    xkb_variant thinkpad
    xkb_numlock enabled
}

input type:touchpad {
    natural_scroll enabled
}

input type:pointer {
    accel_profile flat
}

# follow_mouse=0 / no_warps from the old config.
focus_follows_mouse no
mouse_warping none

### Appearance (monochrome) ##################################################

# Hyprland had gaps_in=3 / gaps_out=10; sway's outer gap is added on top of
# the inner one at screen edges, so outer 7 keeps the same 10px edge margin.
gaps inner 3
gaps outer 7

default_border pixel 2
default_floating_border pixel 2

# class                 border  background text    indicator child_border
client.focused          #dddddd #111111    #ffffff #aaaaaa   #dddddd
client.focused_inactive #2a2a2a #000000    #aaaaaa #2a2a2a   #2a2a2a
client.unfocused        #2a2a2a #000000    #777777 #2a2a2a   #2a2a2a
client.urgent           #ffffff #ffffff    #000000 #ffffff   #ffffff

font pango:JetBrainsMono Nerd Font 10

### Bar ######################################################################

bar {
    swaybar_command waybar
}

### Autostart ################################################################
# Integrated from the generated sway-exec-snippet.conf + the old hyprland
# exec-once lines that still apply.

# Polkit authentication agent (graphical sudo/auth prompts).
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Notification daemon.
exec mako

# Automount for removable devices.
exec udiskie --tray

# Network and Bluetooth tray applets.
exec nm-applet --indicator
exec blueman-applet

# Clipboard history (cliphist).
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

# Idle daemon: reads ~/.config/swayidle/config, whose ONLY rule is
# before-sleep -> swaylock. No dpms/inactivity timeouts, on purpose.
exec swayidle -w

# Display layout profiles / night light -- no configs in dotfiles yet, so
# left disabled instead of spawning daemons that exit or misbehave.
# exec kanshi
# exec gammastep

### Lock behavior (exact spec) ###############################################

# On demand.
bindsym $mod+l exec swaylock

# Lock when the lid closes (also while already locked).
bindswitch --locked lid:on exec swaylock

### Keybindings ##############################################################

# Apps
bindsym $mod+Return exec $terminal
bindsym $mod+Shift+Return exec $webbrowser
bindsym $mod+e exec $filemanager
bindsym $mod+r exec $menu

# Window management -- sway's kill covers the old close-window.sh (its only
# special case was yazi, which didn't come along).
bindsym $mod+q kill
bindsym $mod+v floating toggle
bindsym $mod+j layout toggle split
bindsym $mod+Tab focus next

# Session
bindsym $mod+Shift+r reload
bindsym $mod+m exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'

# Keybind cheatsheet
bindsym $mod+h exec $scripts/keybind-help.sh

# Clipboard history
bindsym $mod+c exec cliphist list | wofi --dmenu | cliphist decode | wl-copy

# Color picker (grim+slurp, no extra deps) -> copies hex to clipboard
bindsym $mod+Shift+c exec $scripts/color-picker.sh

# Screenshots (same behavior as before)
bindsym Print exec bash -c 'mkdir -p "$HOME/Pictures/Screenshots"; f="$HOME/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png"; grim -g "$(slurp)" "$f" && wl-copy --type image/png < "$f"'
bindsym Shift+Print exec bash -c 'mkdir -p "$HOME/Pictures/Screenshots"; f="$HOME/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png"; grim "$f" && wl-copy --type image/png < "$f"'

# Screen recording toggle (gpu-screen-recorder via the wlr portal)
bindsym F10 exec $scripts/record.sh
bindsym Shift+F10 exec $scripts/record.sh

# Focus with arrows
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

# Move window within tiling; left/right wraps to the adjacent workspace at
# the edge (same behavior as the old move-window.sh).
bindsym $mod+Shift+Left exec $scripts/move-window.sh l
bindsym $mod+Shift+Right exec $scripts/move-window.sh r
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

# Send window straight to the adjacent workspace (and follow it).
bindsym $mod+Ctrl+Left exec $scripts/move-window.sh ws-l
bindsym $mod+Ctrl+Right exec $scripts/move-window.sh ws-r

# Workspaces 1-10
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Scratchpad (the old "special workspace magic")
bindsym $mod+s scratchpad show
bindsym $mod+Shift+s move scratchpad

# Workspace scroll with $mod + mouse wheel
bindsym --whole-window $mod+button4 workspace prev_on_output
bindsym --whole-window $mod+button5 workspace next_on_output

# Move/resize floating windows with $mod + mouse drag
floating_modifier $mod normal

# Three-finger horizontal swipe switches workspace (old gesture line)
bindgesture swipe:3:right workspace prev_on_output
bindgesture swipe:3:left workspace next_on_output

# Volume / mic / brightness (work on the lock screen too)
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl -e4 -n2 set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-

# Media keys (playerctl)
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous

### Drop-ins #################################################################

include ~/.config/sway/config.d/*
